    agent {label 'srv3-danu'}
    stages {
        stage('Checkout'){steps{checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/danutebe/simple-apps.git']]) }}
